# Copy this to .env and fill in real values. Never commit .env to git.

PORT=8000

# YouTube Data API v3 (for live chat read/write)
YOUTUBE_API_KEY=

# YouTube OAuth (for posting chat as channel account)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Supabase (when you add auth + database)
SUPABASE_URL=
SUPABASE_ANON_KEY=
